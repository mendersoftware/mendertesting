{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":rebaseStalePrs",
    ":semanticCommitTypeAll(chore)"
  ],

  // CODEOWNERS drives reviewer assignment
  "reviewersFromCodeOwners": true,

  // chore(deps): <desc>
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",

  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,

  // Security PRs bypass the schedule
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },

  // Off by default upstream (still "beta"), but dependabot bumped submodules
  // monthly in every repo that has them, so keep that going.
  "git-submodules": {
    "enabled": true
  },

  "packageRules": [
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "semanticCommitType": "ci",
      "semanticCommitScope": ""
    }
  ]
}
